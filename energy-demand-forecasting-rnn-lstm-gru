        "        with torch.no_grad():\n",
        "            for xb, yb in val_dl:\n",
        "                xb, yb = xb.to(device), yb.to(device)\n",
        "                total += loss_fn(model(xb), yb).item() * len(xb); n += len(xb)\n",
