        "class LSTMCell(nn.Module):\n",
        "    \"\"\"\n",
        "    i = sigmoid(x W_xi + h W_hi + b_i)    # input gate\n",
        "    f = sigmoid(x W_xf + h W_hf + b_f)    # forget gate\n",
        "    g = tanh   (x W_xg + h W_hg + b_g)    # candidate\n",
        "    o = sigmoid(x W_xo + h W_ho + b_o)    # output gate\n",
        "    c_t = f * c_{t-1} + i * g\n",
        "    h_t = o * tanh(c_t)\n",
        "    \"\"\"\n",
        "    def __init__(self, input_size, hidden_size):\n",
        "        super().__init__()\n",
        "        self.hidden_size = hidden_size\n",
        "        H = hidden_size\n",
        "        k = 1 / math.sqrt(H)\n",
        "        # الـ 4 gates مجمعين في matrix واحدة (أسرع): ترتيبهم [i, f, g, o]\n",
        "        self.W_x = nn.Parameter(torch.empty(input_size, 4 * H).uniform_(-k, k))\n",
        "        self.W_h = nn.Parameter(torch.empty(H, 4 * H).uniform_(-k, k))\n",
        "        b = torch.zeros(4 * H)\n",
        "        b[H:2 * H] = 1.0                      # forget gate bias = 1\n",
        "        self.b = nn.Parameter(b)\n",
        "\n",
        "    def init_state(self, batch_size, device):\n",
        "        z = torch.zeros(batch_size, self.hidden_size, device=device)\n",
        "        return (z, z.clone())                 # (h, c)\n",
        "\n",
        "    def forward(self, x_t, state):\n",
        "        h, c = state\n",
        "        gates = x_t @ self.W_x + h @ self.W_h + self.b      # (B, 4H)\n",
        "        i, f, g, o = gates.chunk(4, dim=1)\n",
        "        i, f, o = torch.sigmoid(i), torch.sigmoid(f), torch.sigmoid(o)\n",
        "        g = torch.tanh(g)\n",
        "        c = f * c + i * g\n",
        "        h = o * torch.tanh(c)\n",
        "        return (h, c)\n",
        "\n",
        "    def get_h(self, state):\n",
        "        return state[0]\n",
        "\n",
        "\n",
        "torch.manual_seed(SEED)\n",
        "lstm_model = SeqModel(LSTMCell(input_size=1, hidden_size=HIDDEN), HIDDEN).to(device)\n",
