        "import time, copy\n",
        "\n",
        "def predict(model, loader):\n",
        "    model.eval()\n",
        "    preds = []\n",
        "    with torch.no_grad():\n",
        "        for xb, _ in loader:\n",
        "            preds.append(model(xb.to(device)).cpu())\n",
        "    return torch.cat(preds).numpy().ravel()\n",
        "\n",
        "def train_model(model, name, epochs=15, lr=1e-3, clip=1.0, patience=3):\n",
        "    optimizer = torch.optim.Adam(model.parameters(), lr=lr)\n",
        "    loss_fn = nn.MSELoss()\n",
        "    history = {\"train\": [], \"val\": []}\n",
        "    best_val, best_state, bad_epochs = float(\"inf\"), None, 0\n",
        "\n",
        "    for epoch in range(1, epochs + 1):\n",
        "        t0 = time.time()\n",
        "\n",
        "        # ---- train ----\n",
        "        model.train()\n",
        "        total, n = 0.0, 0\n",
        "        for xb, yb in train_loader:\n",
        "            xb, yb = xb.to(device), yb.to(device)\n",
        "            optimizer.zero_grad()\n",
        "            loss = loss_fn(model(xb), yb)\n",
        "            loss.backward()\n",
        "            nn.utils.clip_grad_norm_(model.parameters(), clip)\n",
        "            optimizer.step()\n",
        "            total += loss.item() * len(xb)\n",
        "            n += len(xb)\n",
        "        train_loss = total / n\n",
        "\n",
        "        # ---- validation ----\n",
        "        model.eval()\n",
        "        total, n = 0.0, 0\n",
        "        with torch.no_grad():\n",
        "            for xb, yb in val_loader:\n",
        "                xb, yb = xb.to(device), yb.to(device)\n",
        "                total += loss_fn(model(xb), yb).item() * len(xb)\n",
        "                n += len(xb)\n",
        "        val_loss = total / n\n",
        "\n",
        "        history[\"train\"].append(train_loss)\n",
        "        history[\"val\"].append(val_loss)\n",
        "        print(f\"[{name}] epoch {epoch:2d} | train {train_loss:.4f} | val {val_loss:.4f} | {time.time()-t0:.0f}s\")\n",
        "\n",
        "        # ---- early stopping ----\n",
        "        if val_loss < best_val:\n",
        "            best_val, bad_epochs = val_loss, 0\n",
        "            best_state = copy.deepcopy(model.state_dict())\n",
        "        else:\n",
        "            bad_epochs += 1\n",
        "            if bad_epochs >= patience:\n",
        "                print(f\"[{name}] early stop at epoch {epoch}\")\n",
        "                break\n",
        "\n",
        "    model.load_state_dict(best_state)      # نرجع لأحسن وزن\n",
        "    return history\n",
        "\n",
        "# ---- تدريب الـ RNN ----\n",
        "histories = {}\n",
        "histories[\"RNN\"] = train_model(rnn_model, \"RNN\")\n",
        "\n",
        "# ---- تقييم ----\n",
        "val_pred  = predict(rnn_model, val_loader)\n",
        "test_pred = predict(rnn_model, test_loader)\n",
        "results[\"RNN | val\"]  = metrics(y_val.numpy(),  val_pred)\n",
        "results[\"RNN | test\"] = metrics(y_test.numpy(), test_pred)\n",
        "pd.DataFrame(results).T.round(2)"
