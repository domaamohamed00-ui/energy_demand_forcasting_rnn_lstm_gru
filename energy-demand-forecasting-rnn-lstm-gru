        "from numpy.lib.stride_tricks import sliding_window_view\n",
        "from torch.utils.data import TensorDataset, DataLoader\n",
        "\n",
        "LOOKBACK = 168     # أسبوع كامل (168 ساعة)\n",
        "BATCH_SIZE = 256\n",
        "\n",
        "def make_windows(series, lookback, context=None):\n",
        "    # لو فيه context (آخر جزء من السبلت اللي قبله) نحطه الأول\n",
        "    if context is not None:\n",
        "        series = np.concatenate([context[-lookback:], series])\n",
        "    w = sliding_window_view(series, lookback + 1)     # (N, lookback+1)\n",
        "    X = w[:, :-1, None].copy()                        # (N, lookback, 1)\n",
        "    y = w[:, -1, None].copy()                         # (N, 1)\n",
        "    return torch.from_numpy(X), torch.from_numpy(y)\n",
        "\n",
        "X_train, y_train = make_windows(train_s, LOOKBACK)\n",
        "X_val,   y_val   = make_windows(val_s,   LOOKBACK, context=train_s)\n",
        "X_test,  y_test  = make_windows(test_s,  LOOKBACK, context=val_s)\n",
