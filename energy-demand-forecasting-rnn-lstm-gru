        "        np.sin(2 * np.pi * h / 24),       np.cos(2 * np.pi * h / 24),\n",
        "        np.sin(2 * np.pi * d / 7),        np.cos(2 * np.pi * d / 7),\n",
        "        np.sin(2 * np.pi * (m - 1) / 12), np.cos(2 * np.pi * (m - 1) / 12),\n",
        "    ], axis=1).astype(np.float32)                      # (T, 7)\n",
