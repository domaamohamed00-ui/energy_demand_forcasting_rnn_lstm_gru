        "class GRUCell(nn.Module):\n",
        "    \"\"\"\n",
        "    r = sigmoid(x W_xr + b_xr + h W_hr + b_hr)          # reset gate\n",
        "    z = sigmoid(x W_xz + b_xz + h W_hz + b_hz)          # update gate\n",
        "    n = tanh   (x W_xn + b_xn + r * (h W_hn + b_hn))    # candidate\n",
        "    h_t = (1 - z) * n + z * h_{t-1}\n",
        "    \"\"\"\n",
        "    def __init__(self, input_size, hidden_size):\n",
        "        super().__init__()\n",
        "        self.hidden_size = hidden_size\n",
        "        H = hidden_size\n",
        "        k = 1 / math.sqrt(H)\n",
        "        # الـ 3 أجزاء مجمعين: ترتيبهم [r, z, n]\n",
        "        self.W_x = nn.Parameter(torch.empty(input_size, 3 * H).uniform_(-k, k))\n",
        "        self.W_h = nn.Parameter(torch.empty(H, 3 * H).uniform_(-k, k))\n",
        "        self.b_x = nn.Parameter(torch.zeros(3 * H))\n",
        "        self.b_h = nn.Parameter(torch.zeros(3 * H))\n",
        "\n",
        "    def init_state(self, batch_size, device):\n",
        "        return torch.zeros(batch_size, self.hidden_size, device=device)\n",
        "\n",
        "    def forward(self, x_t, h):\n",
        "        gx = x_t @ self.W_x + self.b_x          # (B, 3H)\n",
        "        gh = h   @ self.W_h + self.b_h          # (B, 3H)\n",
        "        xr, xz, xn = gx.chunk(3, dim=1)\n",
        "        hr, hz, hn = gh.chunk(3, dim=1)\n",
        "\n",
        "        r = torch.sigmoid(xr + hr)\n",
        "        z = torch.sigmoid(xz + hz)\n",
        "        n = torch.tanh(xn + r * hn)\n",
        "        return (1 - z) * n + z * h\n",
        "\n",
        "    def get_h(self, state):\n",
        "        return state\n",
